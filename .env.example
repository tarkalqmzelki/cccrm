# Calista Concept — environment variables
# Copy this file to `.env` and fill in your project's values.

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPID public key for Web Push notifications (required for push)
# Generate a key pair with:
#   npx web-push generate-vapid-keys
# Or use Supabase dashboard → Settings → API → "Web Push" (if available).
# Keep the private key ONLY in Supabase Edge Function secrets (never in .env).
VITE_VAPID_PUBLIC_KEY=
